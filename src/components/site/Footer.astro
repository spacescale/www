---

/*
  Footer.astro is the shared footer for marketing pages.

  We keep footer link data in arrays so the markup stays clean.
  Later, if links change, we edit the arrays instead of rewriting HTML.
*/

const footerGroups = [
    {
        title: "Resources",
        links: [
            { label: "Documentation", href: "#" },
            { label: "Blog", href: "/blog" },
        ],
    },
    {
        title: "Company",
        links: [
            { label: "Principles", href: "/principles" },
            { label: "Careers", href: "#" },
            { label: "Privacy Policy", href: "#" },
        ],
    },
    {
        title: "Social",
        links: [
            { label: "LinkedIn", href: "https://www.linkedin.com/company/spacescale" },
            { label: "GitHub", href: "https://github.com/spacescale" },
        ],
    },
];
---

<footer class="site-footer" transition:persist>
    <div class="footer-divider" aria-hidden="true"></div>

    <div class="footer-inner">
<section class="footer-brand" aria-label="SpaceScale">
            <a class="brand-lockup" href="/" aria-label="SpaceScale home">
                <span class="brand-mark" aria-hidden="true">
                    <!-- These empty spans become the SpaceScale square-dot logo in CSS. -->
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </span>

                <span class="brand-name">SpaceScale</span>
            </a>
        </section>

        <nav class="footer-links" aria-label="Footer navigation">
            {
                footerGroups.map((group) => (
                    <section>
                        <h3>{group.title}</h3>

                        <ul>
                            {group.links.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </nav>
    </div>
</footer>